.name_card {

background-color: gray;
display: flex;
flex-direction: row;
padding: 10px;
gap: 5px;
border-radius: 5px;
justify-content: center;
}

.name_card .icon {


display: flex;
align-items: center;
justify-content: center;


}

.name_card .name {


display: flex;
align-items: center;
justify-content: center;

}