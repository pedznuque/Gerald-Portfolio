.skill_card {
  border: var(--placeholder-border-color);
  width: 100%;
  min-height: 100px;
  margin-top: 15px;
  border-radius: 5px;
  background-color: var(--placeholder-background-color);
  display: flex;
  flex-direction: row;
  gap: 15px;

  padding: 10px;
  padding-block: 15px;
}

.skill_card .icon_container {
  width: 100px;
  height: 100px;
  border-radius: 5px;
  border: var(--placeholder-border-color);
}

.skill_card .details_container {
  display: flex;
  flex-direction: column;
  gap: 5px;
  align-items: start;
  flex: 1;
}

.skill_card .title {
  margin-top: 5px;
  color: var(--green-font-color);
}

.skill_card .details {
  letter-spacing: 1px;
  font-size: 14px;
  margin-left: 2px;
  margin-top: 5px;
}
