.dmo-logo {
  --bg-dark: #064e3b;
  --bg-main: #0d9488;
  --accent-1: #34d399;
  --accent-2: #facc15;
  --paper: #ffffff;
  --folder: #fde68a;
  --folder-dark: #f59e0b;
  --text-dark: #065f46;

  width: 100px;
  height: 100px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.dmo-card {
  width: 100px;
  height: 100px;
  border-radius: 5px;
  background: linear-gradient(135deg, var(--bg-dark), var(--bg-main));
  position: relative;
  overflow: hidden;
 
  animation: dmoFloat 3s ease-in-out infinite;
}

.dmo-card::before {
  content: "";
  position: absolute;
  width: 130px;
  height: 130px;
  border-radius: 50%;
  background: rgba(52, 211, 153, 0.24);
  top: -48px;
  right: -42px;
  animation: dmoGlow 4s ease-in-out infinite;
}

.dmo-database {
  width: 38px;
  height: 46px;
  position: absolute;
  top: 17px;
  left: 14px;
  animation: dmoDatabasePulse 2.5s ease-in-out infinite;
}

.dmo-db-top {
  width: 38px;
  height: 13px;
  background: var(--paper);
  border-radius: 50%;
  position: absolute;
  top: 0;
  left: 0;
  box-shadow: inset 0 -3px 0 rgba(6, 95, 70, 0.15);
}

.dmo-db-body {
  width: 38px;
  height: 34px;
  background: var(--paper);
  border-radius: 0 0 18px 18px;
  position: absolute;
  top: 7px;
  left: 0;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
}

.dmo-db-body::before,
.dmo-db-body::after {
  content: "";
  position: absolute;
  width: 38px;
  height: 13px;
  border-radius: 50%;
  left: 0;
  border-bottom: 2px solid rgba(6, 95, 70, 0.25);
}

.dmo-db-body::before {
  top: 6px;
}

.dmo-db-body::after {
  top: 17px;
}

.dmo-db-line {
  height: 3px;
  background: var(--accent-1);
  border-radius: 10px;
  position: absolute;
  left: 10px;
  animation: dmoDataBlink 2s ease-in-out infinite;
}

.dmo-db-line-1 {
  width: 18px;
  top: 15px;
}

.dmo-db-line-2 {
  width: 14px;
  top: 26px;
  animation-delay: 0.3s;
}

.dmo-folder {
  width: 44px;
  height: 35px;
  position: absolute;
  right: 12px;
  bottom: 22px;
  animation: dmoFolderSlide 2.6s ease-in-out infinite;
}

.dmo-folder-tab {
  width: 22px;
  height: 10px;
  background: var(--folder-dark);
  border-radius: 6px 6px 0 0;
  position: absolute;
  top: 0;
  left: 3px;
}

.dmo-folder-body {
  width: 44px;
  height: 28px;
  background: var(--folder);
  border-radius: 7px;
  position: absolute;
  bottom: 0;
  left: 0;
  box-shadow: 0 6px 14px rgba(0, 0, 0, 0.25);
}

.dmo-file {
  width: 22px;
  height: 4px;
  background: var(--text-dark);
  border-radius: 10px;
  position: absolute;
  left: 11px;
  animation: dmoFileSort 2s ease-in-out infinite;
}

.dmo-file-1 {
  top: 10px;
}

.dmo-file-2 {
  top: 18px;
  width: 16px;
  animation-delay: 0.25s;
}

.dmo-check {
  width: 23px;
  height: 12px;
  border-left: 5px solid var(--accent-2);
  border-bottom: 5px solid var(--accent-2);
  position: absolute;
  right: 21px;
  top: 20px;
  transform: rotate(-45deg);
  animation: dmoCheckPop 2.2s ease-in-out infinite;
}


@keyframes dmoGlow {
  0%, 100% {
    transform: scale(1);
    opacity: 0.7;
  }

  50% {
    transform: scale(1.25);
    opacity: 1;
  }
}

@keyframes dmoDatabasePulse {
  0%, 100% {
    transform: scale(1);
  }

  50% {
    transform: scale(1.05);
  }
}

@keyframes dmoDataBlink {
  0%, 100% {
    opacity: 0.35;
    transform: scaleX(0.7);
  }

  50% {
    opacity: 1;
    transform: scaleX(1);
  }
}

@keyframes dmoFolderSlide {
  0%, 100% {
    transform: translateX(0);
  }

  50% {
    transform: translateX(-4px);
  }
}

@keyframes dmoFileSort {
  0%, 100% {
    opacity: 0.45;
    transform: translateX(0);
  }

  50% {
    opacity: 1;
    transform: translateX(4px);
  }
}

@keyframes dmoCheckPop {
  0% {
    opacity: 0;
    transform: scale(0.65) rotate(-45deg);
  }

  45%, 100% {
    opacity: 1;
    transform: scale(1) rotate(-45deg);
  }
}