.intro_dashboard {

display: flex;
flex-direction: column;
align-items: flex-start;
gap: 10px;
padding-inline: 20px;


}

.profile_intro {

display: flex;
flex-direction: row;
border: var(--placeholder-border-color);
border-radius: 5px;
padding: 20px;
margin-bottom: 10px;
margin-top: 10px;
background-color: var(--placeholder-background-color);
letter-spacing: 1px;
gap: 10px;

}

.profile_intro .image_holder {

width: 100%;
height: 220px;
border-radius: 5px;
border: var(--placeholder-border-color);

}

.profile_intro .image_holder img {

width: 100%;
height: 100%;
object-fit: cover;
border-radius: 5px;



}

.profile_intro .profile {


width: 40%;
display: flex;
align-items: center;
justify-content: center;
}

.profile_intro .intro_text {


width: 60%;

}