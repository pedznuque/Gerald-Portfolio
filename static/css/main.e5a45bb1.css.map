.dark-mode-toggle {
  --toggle-size: 32px;

  width: calc(var(--toggle-size) * 1.9);
  height: var(--toggle-size);
  padding: 3px;

  display: flex;
  align-items: center;
  margin-top: 3px;
  border: none;
  border-radius: 999px;
  cursor: pointer;
  background: linear-gradient(135deg, #facc15, #fb923c);

  transition:
    background 0.4s ease,
    box-shadow 0.4s ease,
    transform 0.2s ease;
}

.dark-mode-toggle.glow {
  box-shadow: 0 0 14px rgba(251, 146, 60, 0.6);
}

.dark-mode-toggle:hover {
  transform: scale(1.08);
}

.dark-mode-toggle:active {
  transform: scale(0.93);
}

.dark-mode-icon {
  width: calc(var(--toggle-size) - 6px);
  height: calc(var(--toggle-size) - 6px);

  display: flex;
  align-items: center;
  justify-content: center;

  border-radius: 50%;
  background-color: white;
  color: #f59e0b;

  font-size: calc(var(--toggle-size) * 0.42);

  transform: translateX(0) rotate(0deg);

  transition:
    transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1),
    background-color 0.3s ease,
    color 0.3s ease;
}

.dark-mode-toggle.active {
  background: linear-gradient(135deg, #111827, #4f46e5);
}

.dark-mode-toggle.active.glow {
  box-shadow: 0 0 16px rgba(99, 102, 241, 0.75);
}

.dark-mode-toggle.active .dark-mode-icon {
  background-color: #e0e7ff;
  color: #4f46e5;
  transform: translateX(calc(var(--toggle-size) * 0.9)) rotate(360deg);
}