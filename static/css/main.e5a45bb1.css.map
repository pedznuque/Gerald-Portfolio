.certificate_card {

border: var(--placeholder-border-color);
width: 100%;
min-height: 100px;
margin-top: 15px;
border-radius: 5px;
background-color: var(--placeholder-background-color);
display: flex;
flex-direction: row;
gap: 15px;

padding: 10px;
padding-block: 15px;

}


.certificate_card .image_container {


  width: 100px;
  height: 100px;
  border-radius: 5px;
  background-color: gainsboro;

}

.certificate_card img {
width: 100%;
height: 100%;
object-fit: cover;
border: var(--placeholder-border-color);
border-radius: 5px;

}

.certificate_card .details_container {


flex: 1;
display: flex;
flex-direction: column;
align-items: start;

}

.certificate_card .title {
  
  color: var(--green-font-color);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 7px;
  font-weight: bold;

}

.certificate_card .details {

letter-spacing: 1px;
font-size: 14px;
margin-left: 2px;
margin-top: 5px;

}

.certificate_card a p{

margin-bottom: 2px;
}

.certificate_card a {

color: var(--green-font-color);
text-decoration: none;
margin-top: 15px;
font-weight: bold;
display: flex;
flex-direction: row;
align-items: center;
gap: 5px;
}


.certificate_card .action_container {

display: flex;
justify-content: center;
align-items: flex-start;

}

.certificate_card .view_button {

background-color: var(--button-color);
padding-inline: 20px;
padding-block: 10px;
margin-right: 10px;
border-radius: 5px;
color: var(--white-font-color);
font-weight: bold;
display: flex;
align-items: center;
justify-content: center;
cursor: pointer;
margin-top: 2px;

}


.viewer_overlay {
  position: fixed;
  inset: 0;

  background: rgba(0, 0, 0, 0.662);

  display: flex;
  justify-content: center;
  align-items: center;

  z-index: 999999;
}

.viewer_modal {
  width: 60%;
  max-width: 800px;

  background: rgba(0, 0, 0, 0.881);
  border-radius: 5px;

  padding: 25px;

  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 15px;
}

.viewer_modal img {
  width: 100%;
  max-height: 80vh;

  object-fit: contain;
  border-radius: 5px;
}

.viewer_modal button {
  padding-inline: 20px;
  padding-block: 10px;

  border: none;
  border-radius: 5px;

  background: green;
  color: white;

  cursor: pointer;
}