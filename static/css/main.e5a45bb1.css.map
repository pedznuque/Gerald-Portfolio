.gear-box {
  width: 100px;
  height: 100px;

  position: relative;

  background: white;
  border: 4px solid rgb(197, 195, 195);
  border-radius: 12px;

  overflow: hidden;
}

/* BASE GEAR */

.gear {
  position: absolute;

  border-radius: 50%;

  animation: rotate 4s linear infinite;
}

/* INNER CIRCLE */

.gear::after {
  content: "";

  position: absolute;

  top: 50%;
  left: 50%;

  width: 40%;
  height: 40%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background: white;
  border: 2px solid black;

  z-index: 2;
}

/* TEETH */

.gear::before {
  content: "";

  position: absolute;
  inset: -10%;

  border-radius: 50%;

  z-index: 1;
}

/* LARGE */

.large {
  width: 42px;
  height: 42px;

  top: 8px;
  left: 8px;

  background: #f4d03f;
}

.large::before {
  background:
    repeating-conic-gradient(
      #f4d03f 0deg 20deg,
      transparent 20deg 45deg
    );
}

/* MEDIUM */

.medium {
  width: 34px;
  height: 34px;

  right: 8px;
  top: 34px;

  background: #ff5c75;

  animation-direction: reverse;
}

.medium::before {
  background:
    repeating-conic-gradient(
      #ff5c75 0deg 20deg,
      transparent 20deg 45deg
    );
}

/* SMALL */

.small {
  width: 28px;
  height: 28px;

  left: 22px;
  bottom: 8px;

  background: #2ea8ff;
}

.small::before {
  background:
    repeating-conic-gradient(
      #2ea8ff 0deg 20deg,
      transparent 20deg 45deg
    );
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}