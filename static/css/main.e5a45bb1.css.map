.app {
  min-height: 100vh;
  background-color: var(--back-layout-color);
  color: var(--font-color);
  transition: background-color 0.3s ease, color 0.3s ease;
}

.app.dark {
  --back-layout-color: rgb(18, 18, 18);
  --container-border-color: 1px solid rgb(70, 70, 70);
  --dashboard-color: rgb(30, 45, 30);

  --content-container-color: grey;

  --placeholder-background-color: rgb(35, 35, 35);
  --placeholder-border-color: 1px solid rgb(90, 90, 90);

  --button-color: rgb(0, 180, 80);

  --font-color: white;
  --white-font-color: white;
  --green-font-color: rgb(80, 255, 130);
  --green-border-color: 2px solid rgb(80, 255, 130);
}