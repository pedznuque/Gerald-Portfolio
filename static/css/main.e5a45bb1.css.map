.letswork_dashboard {



}

.service_container {

display: flex;
flex-direction: row;
justify-content: center;
gap: 50px;
margin-top: 20px;
margin-bottom: 20px;
}

.service_placeholder {


border: 1px solid rgb(187, 187, 187);
background-color: var(--placeholder-background-color);
width: 130px;
height: 130px;
border-radius: 5px;
display: flex;
flex-direction: column;
align-items: center;
padding: 10px;
gap: 10px;
    
}

.service_placeholder img {

    width: 70px;
    height: 70px;

}

.service_placeholder .title {


    font-size: 12px;
    font-weight: bold;
    text-align: center;
}