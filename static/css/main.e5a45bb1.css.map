.stat_dashboard {
  padding-inline: 20px;
  display: flex;
  flex-direction: row;
  width: 100%;
  justify-content: space-between;
  gap: 10px;
  margin-bottom: 15px;
}

.gear_card,
.radar_card {
  flex: 1;

  border-radius: 5px;
  background-color: var(--placeholder-background-color);
  display: flex;
  flex-direction: row;
  padding: 10px;
  border: 1px solid rgb(184, 184, 184);
  gap: 5px;
}

.radar_card .radar_container,
.radar_card .details_container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.radar_card .radar_container {
}

.radar_card .details_container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.gear_card .gear_container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
}

.gear_card .details_container {

  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10px;
  justify-content: center;
  align-items: flex-start;

}

.gear_card .details_container p {

   font-size: 14px; 
   display: flex;
   flex-direction: row;
   gap: 5px;
}